OPENAI_API_KEY=твій_openai_ключ_тут
AI_PROVIDER=openai
EMAIL_AI_PROVIDER=openai
OPENAI_MAIN_MODEL=gpt-5-mini
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=low
OPENAI_TEXT_VERBOSITY=medium

# Anthropic вимкнений за замовчуванням. Увімкнути fallback можна тільки явно.
ALLOW_ANTHROPIC_FALLBACK=0
ANTHROPIC_API_KEY=твій_anthropic_ключ_тут

PORT=3000
HOST=127.0.0.1
STORE_OWNER_NAME=Максим
STORE_OWNER_SIGNATURE=Максим, Mercato
TELEGRAM_BOT_USERNAME=MercatoAI_bot
# Optional full bot URL override. If empty, https://t.me/TELEGRAM_BOT_USERNAME is used.
TELEGRAM_BOT_URL=
# Optional protected Flask bot summary for Command Center Telegram reach/signals.
TELEGRAM_BOT_INTERNAL_URL=http://127.0.0.1:5000
TELEGRAM_BOT_INTERNAL_TOKEN=

# Local durable operational store. JSON files remain fallback/cache; this stores actions, email tracking,
# publish runs and trust checks.
OPERATIONAL_DB_PATH=mercato-operational.sqlite
OPERATIONAL_DB_DISABLED=0

# OpenCart bridge
BRIDGE_URL=https://mercato.com.ua/mercato-bridge.php
BRIDGE_SECRET=
MERCHANT_BRIDGE_TIMEOUT_MS=30000

# Supplier sync: Coffeeton
COFFEETON_PRICE_URL=https://coffeeton.com/price/
# Опціонально: cookie з вашої авторизованої сесії Coffeeton, якщо треба бачити закриті ціни
COFFEETON_COOKIE=
# Опціонально для локального тесту парсера без мережі
COFFEETON_PRICE_HTML_PATH=

# Pricing calculator (формули перенесені з Google Sheet "Рассчеты Меркато")
# Якщо NBU недоступний з локальної машини, можна тимчасово вказати курс вручну.
MERCATO_NBU_USD_RATE=
MERCATO_PRICE_GREEN_VAT_RATE=0.2
MERCATO_PRICE_ROAST_LOSS_RATE=0.22
MERCATO_PRICE_PACKAGE_PER_KG=10
MERCATO_PRICE_ELECTRICITY_PER_KG=10
MERCATO_PRICE_DELIVERY_PER_KG=20
MERCATO_PRICE_SALE_MARKUP=0.35
MERCATO_PRICE_CATALOG_MARKUP=0.3
MERCATO_PRICE_SITE_OVERHEAD=43.905
MERCATO_PRICE_ROUND_STEP=5

# Security / public hosting
# Якщо задано, небезпечні endpoints вимагають header X-API-Key або Authorization: Bearer ...
COMMAND_API_KEY=
# Через кому: http://localhost:3001,https://your-command-center.example.com
# Якщо порожньо, local dev дозволяє localhost і STORE_BASE_URL.
CORS_ORIGINS=http://localhost:3001,https://mercato.com.ua,https://crm.mercato.com.ua
PUBLIC_BASE_URL=https://crm.mercato.com.ua
TRACKING_BASE_URL=https://crm.mercato.com.ua

# SEO measurement layer
STORE_BASE_URL=https://mercato.com.ua
SITEMAP_URL=https://mercato.com.ua/sitemap.xml
GSC_SITE_URL=sc-domain:mercato.com.ua
# Варіант 1: OAuth client JSON із Google Cloud Console; token збережеться локально в gsc-oauth-token.json
GSC_OAUTH_CLIENT_FILE=/absolute/path/to/gsc_oauth_client.json
GSC_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/seo/gsc/oauth/callback
# Варіант 2: короткоживучий OAuth access token
GSC_ACCESS_TOKEN=
# Варіант 3: service account, який додано в Google Search Console property
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
